{
  "name": "pithos",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "browser": {
    "fs": "./src/stubs/fs.js",
    "path": "./src/stubs/empty.js",
    "os": "./src/stubs/empty.js",
    "crypto": "./src/stubs/empty.js",
    "stream": "./src/stubs/empty.js",
    "util": "./src/stubs/empty.js",
    "events": "./src/stubs/empty.js",
    "http": "./src/stubs/empty.js",
    "https": "./src/stubs/empty.js",
    "net": "./src/stubs/empty.js",
    "tls": "./src/stubs/empty.js",
    "zlib": "./src/stubs/empty.js",
    "child_process": "./src/stubs/empty.js",
    "buffer": "./src/stubs/empty.js",
    "url": "./src/stubs/empty.js",
    "querystring": "./src/stubs/empty.js",
    "assert": "./src/stubs/empty.js"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite --host",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc && vite build && npm run build:server",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.js",
    "start": "node dist-server/index.js",
    "db:up": "docker compose up -d db",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:server": "tsc --noEmit -p server/tsconfig.json"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@heroicons/react": "^2.2.0",
    "@hono/node-server": "^2.1.5",
    "@mui/icons-material": "^6.2.1",
    "@mui/material": "^6.2.1",
    "@tanstack/react-query": "^5.62.8",
    "axios": "^1.7.9",
    "better-auth": "^1.7.14",
    "chart.js": "^4.4.1",
    "date-fns": "^3.3.1",
    "hono": "^4.13.14",
    "lucide-react": "^0.344.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.22.3",
    "recharts": "^2.13.3",
    "uuid": "^11.0.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.12.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.18",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "terser": "^5.28.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^5.4.14",
    "vitest": "^2.1.8"
  }
}
