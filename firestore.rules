rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User data and subcollections
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Connected stores (Shopify, WooCommerce, ...)
      match /stores/{storeId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Per-store-view customizable dashboard layout (Overview's drag/resize
      // grid). Keyed by a real store id or a sanitized "all stores" sentinel
      // (see toLayoutDocId in src/utils/storeDisplay.ts) - never the raw
      // ALL_STORES_ID-style constant, which Firestore rejects as a document
      // id (reserved leading/trailing double-underscore pattern).
      match /dashboardLayouts/{storeKey} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Account-level preferences (theme, language, notification toggles,
      // inventory thresholds) set from the Settings page.
      match /settings/{document} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // AI chat/recommendations usage counters - written ONLY by
      // functions/api/openai/[[path]].ts (server's own OpenAI key, quota
      // enforced server-side). Clients may read their own usage but never
      // write it directly.
      match /aiUsage/{document} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }

    // Legacy top-level Shopify credentials doc, keyed by uid (still read by AuthPage.tsx)
    match /shopify_credentials/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Shopify OAuth install state (one-time, ~10min TTL), written only by
    // functions/api/shopify/oauth/{start,callback}.ts via the Admin SDK.
    match /shopifyOAuthState/{state} {
      allow read, write: if false;
    }

    // WooCommerce "Connect with WooCommerce" state (one-time, ~10min TTL),
    // written only by functions/api/woocommerce/oauth/{start,callback}.ts.
    match /woocommerceOAuthState/{nonce} {
      allow read, write: if false;
    }

    // Default deny - nothing else is accessible from the client.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
