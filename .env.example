# Copy to `.env` and fill in. Used by `npm run dev` and by `docker compose`.
# Never commit `.env`.

# --- Required ----------------------------------------------------------------

# Public URL people open the app on (no trailing slash). Used for login
# cookies and for Shopify/WooCommerce/Google redirect URLs.
#   docker compose   -> http://localhost:3000 (or your real domain)
#   npm run dev      -> http://localhost:5173
APP_URL=http://localhost:3000

# Signs sessions AND encrypts each user's OpenAI key and store credentials.
# At least 32 characters - generate one with:  openssl rand -base64 32
# Changing it later signs everyone out and makes saved keys unreadable
# (users re-enter their OpenAI key and reconnect their stores).
BETTER_AUTH_SECRET=

# Postgres connection. This matches the `db` service in docker-compose.yml
# (`npm run db:up`); docker compose sets its own value for the app container.
DATABASE_URL=postgres://stockpilot:stockpilot@localhost:5432/stockpilot

# --- Optional ----------------------------------------------------------------

# "Continue with Google" sign-in. Create an OAuth client at
# https://console.cloud.google.com/apis/credentials with the redirect URI
#   {APP_URL}/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# One-click "Connect with Shopify" - from YOUR OWN Shopify app (see README).
# Without these, users connect Shopify by pasting an Admin API access token.
# The app's allowed redirection URL must be {APP_URL}/api/shopify/oauth/callback
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# SHOPIFY_SCOPES=read_products,read_orders,read_customers

# Every user adds their own OpenAI API key in Settings -> AI. These only
# change which models / endpoint those keys are used with.
# OPENAI_CHAT_MODEL=gpt-5.6-luna
# OPENAI_RECOMMENDATIONS_MODEL=gpt-5.6-terra
# OPENAI_BASE_URL=https://api.openai.com/v1

# Port the server listens on (default 3000).
# PORT=3000
